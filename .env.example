# 복사해서 .env 로 저장 후 실제 비밀번호로 채우세요.
# 강한 비밀번호 생성: openssl rand -base64 24 | tr -d '/+=' | head -c 28
MONGO_ROOT_USER=vpnroot
MONGO_ROOT_PASS=change-me-strong-root-password
MONGO_APP_USER=vpnapp
MONGO_APP_PASS=change-me-strong-app-password
MONGO_URI=mongodb://vpnapp:change-me-strong-app-password@127.0.0.1:27017/vpnlab?authSource=vpnlab
